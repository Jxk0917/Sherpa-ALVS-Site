<!-- ═══ ANNOUNCEMENT ═══
     The announce bar, the nav and the page's crimson head are one field,
     so these three stay contiguous. The link opens the compliance dialog.
     Homepage-only exception (Jack, 2026-08-24): on "/" the compliance
     trigger moves to the floating corner-stack widget instead (see
     components/corner-stack.njk), so it is left out of the bar here to
     avoid offering it twice on that one page. Every other page keeps it
     in the bar exactly as before. -->
<div class="announce">
  {{ site.announce }}
  {%- if page.url != "/" %}
  <button class="announce-link" type="button" data-compliance-open>Texas compliance</button>
  {%- endif %}
</div>

<!-- ═══ NAV ═══ -->
<header class="nav" id="nav">
  <div class="shell nav-inner">
    <a class="nav-logo" href="/" aria-label="Sherpa, home">
      <img class="logo-dark" src="/assets/logo-crimson.png" alt="Sherpa" width="318" height="140">
      <img class="logo-light" src="/assets/logo-white.png" alt="" aria-hidden="true" width="318" height="140">
    </a>
    <nav class="nav-links" aria-label="Products">
      {%- for f in families %}
      <a class="nav-link{% if page.url.startsWith('/shop/' + f.slug) %} is-current{% endif %}"
         href="/shop/{{ f.slug }}/"
         {% if page.url.startsWith('/shop/' + f.slug) %}aria-current="page"{% endif %}>{{ f.nav }}</a>
      {%- endfor %}
      <a class="nav-link{% if page.url.startsWith('/shop/bundles') %} is-current{% endif %}"
         href="/shop/bundles/"
         {% if page.url.startsWith('/shop/bundles') %}aria-current="page"{% endif %}>Bundles</a>
    </nav>
    <div class="nav-actions">
      <a class="iconbtn" href="/shop/" aria-label="Shop all products">
        <svg width="21" height="21" aria-hidden="true" viewBox="0 0 24 24"><use href="#i-search"/></svg>
      </a>
      <a class="iconbtn" href="/company/contact/" aria-label="Contact">
        <svg width="21" height="21" aria-hidden="true" viewBox="0 0 24 24"><use href="#i-user"/></svg>
      </a>
      <button class="iconbtn only-mobile" id="menu-open" type="button"
              aria-label="Open menu" aria-expanded="false" aria-controls="menu">
        <svg width="22" height="22" aria-hidden="true" viewBox="0 0 24 24"><use href="#i-menu"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- ═══ MOBILE MENU ═══ -->
<div class="menu-panel" id="menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <div class="shell" style="padding-block:1.1rem 3rem">
    <div class="nav-inner" style="height:auto;padding-block:.5rem 1.5rem">
      <img src="/assets/logo-crimson.png" alt="Sherpa" style="height:30px;width:auto">
      <button class="iconbtn" id="menu-close" type="button" aria-label="Close menu">
        <svg width="22" height="22" aria-hidden="true" viewBox="0 0 24 24"><use href="#i-close"/></svg>
      </button>
    </div>
    <nav aria-label="Products">
      {%- for f in families %}
      <a class="menu-link" href="/shop/{{ f.slug }}/">{{ f.nav }} <svg width="20" height="20" class="arw" aria-hidden="true" viewBox="0 0 24 24"><use href="#i-arrow"/></svg></a>
      {%- endfor %}
      <a class="menu-link" href="/shop/bundles/">Bundles <svg width="20" height="20" class="arw" aria-hidden="true" viewBox="0 0 24 24"><use href="#i-arrow"/></svg></a>
    </nav>
    <a class="btn btn-primary" href="/shop/" style="margin-top:2rem;width:100%">
      Shop all <svg width="18" height="18" class="arw" aria-hidden="true" viewBox="0 0 24 24"><use href="#i-arrow"/></svg>
    </a>
  </div>
</div>
