<!-- ═══ FOOTER ═══ -->
<footer class="footer band">
  <div class="shell">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/assets/logo-white.png" alt="Sherpa" width="318" height="140">
        <p>Hemp measured to the milligram, guided by people who've been up the mountain. San Antonio, Texas.</p>
        <div class="social">
          <a href="/company/contact/" aria-label="Instagram"><svg width="19" height="19" aria-hidden="true" viewBox="0 0 24 24"><use href="#i-ig"/></svg></a>
          <a href="/company/stockists/" aria-label="Find a stockist"><svg width="19" height="19" aria-hidden="true" viewBox="0 0 24 24"><use href="#i-pin"/></svg></a>
          <a href="/learn/lab-results/" aria-label="Lab results"><svg width="19" height="19" aria-hidden="true" viewBox="0 0 24 24"><use href="#i-flask"/></svg></a>
        </div>
      </div>
      {%- for group in site.footerGroups %}
      <div>
        <h3>{{ group.title }}</h3>
        <ul>
          {%- for link in group.links %}
          <li><a href="{{ link.url }}">{{ link.label }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
    </div>

    <div class="legal">
      <div>
        <p>
          Must be 21 or older. These statements have not been evaluated by the Food and Drug
          Administration. Products are not intended to diagnose, treat, cure or prevent any
          disease. All products contain less than 0.3% &#916;9-THC by dry weight in compliance
          with the 2018 Farm Bill.
        </p>
        <p style="margin:0">&copy; 2026 Sherpa. All rights reserved.</p>
      </div>
      <div class="legal-links">
        {%- for link in site.legalLinks %}
        <a href="{{ link.url }}">{{ link.label }}</a>
        {%- endfor %}
        <button class="legal-btn" type="button" data-compliance-open>Compliance</button>
      </div>
    </div>
  </div>
</footer>
